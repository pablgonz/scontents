% \subsection{Keys for the package}\label{key:package}
%
% \begin{macro}[int]{\l_@@_tab_width_int, \@@_set_positive_int:Nnn}
%   The integer variable \myhlc|\l_@@_tab_width_int| stores the value of
%   the \mykey{width-tab} key. The function
%   \myhlc|\@@_set_positive_int:Nnn| sets the integer variable passed in
%   |#1| to the value passed in |#3| only if it is a
%   \mymeta{positive integer}, otherwise it raises the \enquote{error}
%   |positive-integer| naming the \mymeta{key} passed in |#2| and the
%   value is ignored. It is used by the \mykey{width-tab} key and by the
%   \mykey{start}, \mykey{step} and \mykey{stop} keys of |\foreachsc|
%   (\S\ref{key:foreachsc}). The core code does not use `|!|' in boolean
%   expressions, so it does not depend on the category code of `|!|' in
%   \hologo{ConTeXt} (\S\ref{subsubsec:generic-layer}).
%    \begin{macrocode}
%<*core>
\int_new:N \l_@@_tab_width_int
\cs_new_protected:Npn \@@_set_positive_int:Nnn #1 #2 #3
  {
    \bool_lazy_or:nnTF
      { \tl_if_blank_p:n {#3} }
      { \int_compare_p:nNn {#3} < { 1 } }
      { \msg_error:nnnn { scontents } { positive-integer } {#2} {#3} }
      { \int_set:Nn #1 {#3} }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]
%   {
%     store-env,
%     store-cmd,
%     verb-font,
%     print-env,
%     print-cmd,
%     force-eol,
%     overwrite,
%     width-tab,
%     print-all,
%     store-all,
%     debug-var,
%     remember,
%     unknown,
%   }
%   We define the common \mymeta{keys} used by the options passed to the
%   package, by |\setupsc| and by the environments and commands. The
%   unknown \mymeta{keys} are passed to \myhlc|\@@_unknown_keys_cmd:n|
%   (\S\ref{key:unknown-keys}), which names the command from
%   \myhlc|\l_@@_cmd_name_tl|: |\usepackage| for the options of the
%   package, |\setupsc| or |\newenvsc| for the \mymeta{initial keys} of
%   an environment.
%    \begin{macrocode}
\keys_define:nn { scontents }
  {
    store-env .tl_set:N         = \l_@@_name_seq_env_tl,
    store-env .initial:n        = contents,
    store-env .value_required:n = true,
    store-cmd .tl_set:N         = \l_@@_name_seq_cmd_tl,
    store-cmd .initial:n        = contents,
    store-cmd .value_required:n = true,
    verb-font .tl_set:N         = \l_@@_verb_font_tl,
    verb-font .value_required:n = true,
    print-env .bool_set:N       = \l_@@_print_env_bool,
    print-env .initial:n        = false,
    print-env .default:n        = true,
    print-cmd .bool_set:N       = \l_@@_print_cmd_bool,
    print-cmd .initial:n        = false,
    print-cmd .default:n        = true,
    force-eol .bool_set:N       = \l_@@_forced_eol_bool,
    force-eol .initial:n        = false,
    force-eol .default:n        = true,
    overwrite .bool_set:N       = \l_@@_overwrite_bool,
    overwrite .initial:n        = false,
    overwrite .default:n        = true,
    width-tab .code:n           =
      { \@@_set_positive_int:Nnn \l_@@_tab_width_int { width-tab } {#1} },
    width-tab .initial:n        = 1,
    width-tab .value_required:n = true,
    print-all .meta:n           = { print-env = #1, print-cmd = #1 },
    print-all .default:n        = true,
    store-all .meta:n           = { store-env = #1, store-cmd = #1 },
    store-all .value_required:n = true,
    debug-var .bool_set:N       = \l_@@_debug_var_bool,
    debug-var .initial:n        = true,
    debug-var .default:n        = true,
    remember  .code:n           = { \@@_remember:n {#1} },
    remember  .value_required:n = true,
    remember  .usage:n          = preamble,
    unknown   .code:n           = { \@@_unknown_keys_cmd:n {#1} },
  }
%</core>
%    \end{macrocode}
%   The default value of the \mykey{verb-font} key depends on the format.
%    \begin{macrocode}
%<loader>\keys_define:nn { scontents }
%<latex>  { verb-font .initial:n = \ttfamily }
%<plain|context>  { verb-font .initial:n = \tt }
%    \end{macrocode}
%   In \LaTeX{} the \mymeta{keys} passed as options to the package are
%   processed and an unknown \mymeta{key} returns an \enquote{error}.
%    \begin{macrocode}
%<*latex>
\tl_set:Nn \l_@@_cmd_name_tl { usepackage }
\ProcessKeyOptions [ scontents ]
%</latex>
%    \end{macrocode}
% \end{macro}
