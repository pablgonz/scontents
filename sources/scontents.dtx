\tl_new:N    \l_@@_env_name_tl
\tl_const:Ne \c_@@_end_env_tl
  {
    \c_backslash_str
%<latex|plain>    end
%<context>    stop
%<latex>    \c_left_brace_str
      \exp_not:N \l_@@_env_name_tl
%<latex>    \c_right_brace_str
