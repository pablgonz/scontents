% \subsection{The command \cs{meaningsc}}\label{cmd:meaningsc}
%
% The user-level command |\meaningsc| prints the meaning of the
% \mymeta{stored contents} of a \emph{sequence}. It takes the same
% arguments as |\typestored| (\S\ref{cmd:typestored}).
%
% \subsubsection{Definition of variables for \cs[no-index]{meaningsc}}
%
% \begin{macro}[int]{\l_@@_meaningsc_arg_tl}
%   The token list \myhlc|\l_@@_meaningsc_arg_tl| saves the
%   \mymeta{stored contents} to print.
%    \begin{macrocode}
\tl_new:N \l_@@_meaningsc_arg_tl
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{Internal functions for \cs[no-index]{meaningsc}}
%
% \begin{macro}[int]{\@@_meaningsc:nn}
%   The function \myhlc|\@@_meaningsc:nn| sets the \mymeta{keys} and the
%   \mymeta{indexes} passed in |#1| with \myhlc|\@@_typemeaning_setup:nn|
%   and calls \myhlc|\@@_meaningsc:n| with the \emph{sequence} named by
%   |#2|.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_meaningsc:nn #1 #2
  {
    \@@_bsphack:
    \group_begin:
      \@@_typemeaning_setup:nn {#1} {#2}
      \bool_if:NF \l_@@_pending_bool { \@@_meaningsc:n {#2} }
      \use:e
        {
          \group_end:
          \bool_if:NF \l_@@_print_verb_style_bool { \@@_esphack: }
        }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_meaningsc:n}
%   The function \myhlc|\@@_meaningsc:n| is defined with the \texttt{TAB}
%   character active. It gets the \mymeta{stored contents}, replaces the
%   ends of line and \myhlc|\c_@@_hidden_space_str| by spaces and each
%   \texttt{TAB} character, active or read from a remembered
%   \emph{sequence} (\S\ref{subsec:remember}), by as many spaces as the
%   \mykey{width-tab} key was set to, prints them with
%   \myhlc|\cs_replacement_spec:N| and writes them with
%   \myhlc|\@@_file_write_cmd:VV|.
%    \begin{macrocode}
\group_begin:
  \char_set_catcode_active:N \^^I
  \cs_new_protected:Npn \@@_meaningsc:n #1
    {
      \tl_set:Ne \l_@@_meaningsc_arg_tl
        { \@@_getfrom_seq:Nn \l_@@_seq_item_seq {#1} }
      \tl_replace_all:Nen \l_@@_meaningsc_arg_tl
        { \iow_char:N \^^J } { ~ }
      \tl_replace_all:Nen \l_@@_meaningsc_arg_tl
        { \c_@@_hidden_space_str } { ~ }
      \bool_if:NT \l_@@_debug_var_bool
        {
          \tl_log:N \l_@@_meaningsc_arg_tl
        }
      \tl_use:N \l_@@_verb_font_tl
      \tl_replace_all:Nne \l_@@_meaningsc_arg_tl
        { ^^I } { \prg_replicate:nn { \l_@@_tab_width_int } { ~ } }
      \tl_replace_all:Nee \l_@@_meaningsc_arg_tl
        { \iow_char:N \^^I }
        { \prg_replicate:nn { \l_@@_tab_width_int } { ~ } }
      \tl_if_empty:NF \l_@@_meaningsc_arg_tl
        {
          \bool_if:NT \l_@@_print_verb_style_bool
            {
              \cs_replacement_spec:N \l_@@_meaningsc_arg_tl
            }
        }
      \@@_file_write_cmd:VV \l_@@_file_name_tl \l_@@_meaningsc_arg_tl
    }
\group_end:
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\meaningsc}
%   Defines the user command \ics*{meaningsc}.
%    \begin{macrocode}
\NewDocumentCommand \meaningsc { o m }
  {
    \tl_set:Nn \l_@@_cmd_name_tl { meaningsc }
    \@@_meaningsc:nn {#1} {#2}
  }
%    \end{macrocode}
% \end{macro}
