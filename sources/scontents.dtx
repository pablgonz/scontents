% \subsection{The command \cs{countsc}}\label{cmd:countsc}
%
% \begin{macro}{\countsc}
%   Defines the user command \ics*{countsc}, which counts the
%   \mymeta{stored contents} in the \emph{sequence}. If the
%   \emph{sequence} does not exist, the \enquote{error}
%   |undefined-storage| is raised and |0| is returned.
%    \begin{macrocode}
\NewExpandableDocumentCommand \countsc { m }
  {
    \@@_seq_if_exist:nTF {#1}
      { \@@_seq_count:n {#1} }
      {
        \msg_expandable_error:nnn { scontents } { undefined-storage } {#1}
        0
      }
  }
%    \end{macrocode}
% \end{macro}
