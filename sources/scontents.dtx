% \subsubsection{Internal functions for unknown keys}
%
% \begin{macro}[int]{\@@_unknown_keys_env:n, \@@_unknown_keys_env:nn}
%   The function \myhlc|\@@_unknown_keys_env:n| raises the
%   \enquote{error} for an unknown \mymeta{key} passed to an environment
%   defined by |\newenvsc|.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_unknown_keys_env:n #1
  { \exp_args:NV \@@_unknown_keys_env:nn \l_keys_key_str {#1} }
\cs_new_protected:Npn \@@_unknown_keys_env:nn #1 #2
  {
    \tl_if_blank:nTF {#2}
      { \msg_error:nnn { scontents } { env-key-unknown } {#1} }
      { \msg_error:nnnn { scontents } { env-key-value-unknown } {#1} {#2} }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_unknown_keys_cmd:n, \@@_unknown_keys_cmd:nn}
%   The function \myhlc|\@@_unknown_keys_cmd:n| raises the
%   \enquote{error} for an unknown \mymeta{key} passed to the commands
%   |\Scontents|, |\foreachsc| and |\setupsc|, to the
%   \mymeta{initial keys} of |\newenvsc| and to the package.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_unknown_keys_cmd:n #1
  { \exp_args:NV \@@_unknown_keys_cmd:nn \l_keys_key_str {#1} }
\cs_new_protected:Npn \@@_unknown_keys_cmd:nn #1 #2
  {
    \tl_if_blank:nTF {#2}
      { \msg_error:nnn { scontents } { cmd-key-unknown } {#1} }
      { \msg_error:nnnn { scontents } { cmd-key-value-unknown } {#1} {#2} }
  }
%    \end{macrocode}
