%<*loader>
\cs_new_protected:Npn \@@_define_env:nnn #1 #2 #3
  {
%<latex|plain>    \NewDocumentEnvironment {#1} { }
%<context>    \cs_new_protected:cpn { start #1 }
      {
%<!latex>        \group_begin:
