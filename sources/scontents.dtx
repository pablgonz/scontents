%   of the package (\S\ref{key:package}).
%    \begin{macrocode}
\NewDocumentCommand \setupsc { +m }
  {
    \tl_set:Nn \l_@@_cmd_name_tl { setupsc }
    \keys_set:nn { scontents } {#1}
  }
%    \end{macrocode}
