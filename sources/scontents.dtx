% \subsubsection{Internal functions for \cs[no-index]{newenvsc}}\label{fun:newenvsc}
%
% \begin{macro}[int]{\@@_grab_opt_arg:w, \@@_grab_opt_arg:n}
%   The function \myhlc|\@@_grab_opt_arg:w| is called with the tokens
%   following |\begin{scontents}| when the next character is a `|[|'. It
%   is defined with \mypkg{ltcmd}\cite{latex2e} to use its delimited
%   argument processor.
%    \begin{macrocode}
\NewDocumentCommand \@@_grab_opt_arg:w { r[] }
  {
    \@@_grab_opt_arg:n {#1}
  }
%    \end{macrocode}
%   The function \myhlc|\@@_grab_opt_arg:n| is called where `|^^M|' is
%   active, so \myhlc|\@@_normalise_line_ends:N| replaces the active
%   `|^^M|' characters by spaces before setting the \mymeta{keys}.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_grab_opt_arg:n #1
  {
    \tl_set:Nn \l_@@_environment_keys_tl {#1}
    \@@_normalise_line_ends:N \l_@@_environment_keys_tl
    \keys_set:nV { scontents / scontents } \l_@@_environment_keys_tl
    \@@_start_after_option:w
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]
%   {
%     \@@_normalise_line_ends:N,
%     \@@_start_environment:w,
%     \@@_start_after_option:w,
%     \@@_check_line_process:nn,
%     \@@_stop_environment:,
%   }
%   Here `|^^I|', `|^^L|' and `|^^M|' are active characters, so that the
%   end of line can be used as a delimiter and \hologo{TeX} does not
%   remove the space-like characters.
%
%   The function \myhlc|\@@_start_environment:w| checks if the next token
%   after |\begin{scontents}| is a `|[|', in that case
%   \myhlc|\@@_grab_opt_arg:w| processes the \emph{optional argument} and
%   calls \myhlc|\@@_start_after_option:w|. In all cases the function
%   \myhlc|\@@_check_line_process:nn| raises the \enquote{error}
%   |junk-after-begin| if there is something else on the line and then
%   calls \myhlc|\@@_file_tl_write_start:V|, which reads the content of
%   the environment and stores it in a token list or writes it to an
%   \mymeta{external file}.
%
%   At the end of the environment, the function
%   \myhlc|\@@_stop_environment:| calls \myhlc|\@@_file_write_stop:N| and
%   issues the \enquote{warning} |empty-environment| if nothing was
%   stored. This part of the code is adapted from the code of the package
%   \mypkg{xsim}\cite{xsim} by Clemens Niederberger.
%    \begin{macrocode}
\group_begin:
  \char_set_catcode_active:N \^^I
  \char_set_catcode_active:N \^^L
  \char_set_catcode_active:N \^^M
  \cs_new_protected:Npn \@@_normalise_line_ends:N #1
    { \tl_replace_all:Nnn #1 { ^^M } { ~ } }
  \cs_new_protected:Npn \@@_start_environment:w #1 ^^M
    {
      \tl_if_head_is_N_type:nTF {#1}
        {
          \str_if_eq:eeTF { \tl_head:n {#1} } { [ }
            { \@@_grab_opt_arg:w #1 ^^M }
            { \@@_check_line_process:nn { } {#1} }
        }
        { \@@_check_line_process:nn { } {#1} }
    }
  \cs_new_protected:Npn \@@_start_after_option:w #1 ^^M
    { \@@_check_line_process:nn { [...] } {#1} }
  \cs_new_protected:Npn \@@_check_line_process:nn #1 #2
    {
      \tl_if_blank:nF {#2}
        {
          \msg_error:nnee { scontents } { junk-after-begin }
            { after~ \@@_env_begin_str:n { \l_@@_env_name_tl } #1 } {#2}
        }
      \@@_make_control_chars_active:
      \@@_file_tl_write_start:V \l_@@_file_name_tl
    }
  \cs_new_protected:Nn \@@_stop_environment:
    {
      \@@_file_write_stop:N \l_@@_processed_body_lines_tl
      \bool_lazy_and:nnT
        { \l_@@_storing_bool }
        { \tl_if_empty_p:N \l_@@_processed_body_lines_tl }
        {
          \msg_warning:nne { scontents } { empty-environment }
            { \l_@@_env_name_tl }
        }
    }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]
%   {
%     \@@_file_tl_write_start:n,
%     \@@_file_tl_write_start:V,
%     \@@_setup_verb_processor:,
%     \@@_verb_processor_iterate:w,
%     \@@_verb_processor_iterate:nnn,
%     \@@_env_end_function:,
%     \@@_file_write_stop:N,
%     \@@_remove_leading_nl:n,
%     \@@_remove_leading_nl:nn,
%     \@@_remove_leading_nl:w,
%   }
%   This is the main function to collect the \mymarg{body env} of the
%   environment. The function \myhlc|\@@_file_tl_write_start:n| starts a
%   \emph{group}, opens the \mymeta{output file} if necessary, sets the
%   \emph{verbatim catcodes} and then issues `|^^M|', set equal to
%   \myhlc|\@@_ret:w|, to read the \mymarg{body env} line by line until
%   its end. Each line read is appended to the output token list after an
%   active `|^^J|' and written to the \mymeta{output file}, if any.
%
%   The function \myhlc|\@@_setup_verb_processor:| defines
%   \myhlc|\@@_verb_processor_iterate:w|, delimited by the end of the
%   current environment, and \myhlc|\@@_verb_processor_iterate:nnn|
%   decides if the line is a nested |\end{scontents}| or the end of the
%   environment, in which case \myhlc|\@@_env_end_function:| leaves the
%   closing command for the current format and the characters after it
%   are rescanned with the \enquote{warning} |rescanning-text|.
%
%   At the end of the environment, the function
%   \myhlc|\@@_file_write_stop:N| closes the \mymeta{output file}, if it
%   was opened, and smuggles the output token list out of the group. The
%   leading `|^^J|' is removed with \myhlc|\@@_remove_leading_nl:n|, which
%   expects an active `|^^J|' at the head of the token list, otherwise a
%   low level \hologo{TeX} \enquote{error} is raised.
%    \begin{macrocode}
  \cs_new_protected:Npn \@@_file_tl_write_start:n #1
    {
      \group_begin:
        \@@_file_if_writable:nTF {#1}
          {
            \bool_set_true:N \l_@@_writable_bool
            \iow_open:Nn \l_@@_file_write_iow {#1}
          }
          { \bool_set_false:N \l_@@_writable_bool }
        \tl_clear:N \l_@@_save_every_body_lines_tl
        \seq_map_function:NN \l_char_special_seq \char_set_catcode_other:N
        \int_step_function:nnnN { 128 } { 1 } { 255 } \char_set_catcode_letter:n
        \cs_set_protected:Npe \@@_ret:w ##1 ^^M
          {
            \exp_not:N \@@_verb_processor_iterate:w
            ##1 \c_@@_end_env_tl
                \c_@@_end_env_tl
                \exp_not:N \q_@@_stop
          }
        \@@_make_control_chars_active:
        \@@_ret:w
    }
  \cs_new_protected:Nn \@@_setup_verb_processor:
    {
      \use:e
        {
          \cs_set_protected:Npn \exp_not:N \@@_verb_processor_iterate:w
            ##1 \c_@@_end_env_tl
            ##2 \c_@@_end_env_tl
            ##3 \exp_not:N \q_@@_stop
        }   { \@@_verb_processor_iterate:nnn {##1} {##2} {##3} }
    }
  \cs_new_protected:Npn \@@_verb_processor_iterate:nnn #1 #2 #3
    {
      \tl_if_blank:nTF {#3}
        {
          \@@_analyse_nesting:n {#1}
          \@@_verb_processor_output:n {#1}
        }
        {
          \@@_if_nested:TF
            {
              \@@_nesting_decr:
              \@@_verb_processor_output:e
                { \exp_not:n {#1} \c_@@_end_env_tl \exp_not:n {#2} }
            }
            {
              \tl_if_blank:nF {#1}
                { \@@_verb_processor_output:n {#1} }
              \cs_set_protected:Npe \@@_ret:w
                {
                  \@@_env_end_function:
                  \bool_lazy_or:nnF
                    { \tl_if_blank_p:n {#2} }
                    { \str_if_eq_p:ee {#2} { \c_percent_str } }
                    {
                      \str_if_eq:VnF \c_@@_hidden_space_str {#2}
                        {
                          \msg_warning:nnnn { scontents } { rescanning-text }
                            {#2} { \tl_use:N \l_@@_env_name_tl }
                        }
                      \tl_retokenize:n {#2}
                    }
                }
              \char_set_active_eq:NN ^^M \@@_ret:w
            }
        }
      ^^M
    }
  \cs_new:Nn \@@_env_end_function:
    {
      \@@_format_case:nnn
        { \exp_not:N \end { \if_false: } \fi: }
        { \exp_after:w \exp_not:N \cs:w end }
        { \exp_after:w \exp_not:N \cs:w stop }
      \tl_use:N \l_@@_env_name_tl
      \@@_format_case:nnn
        { \if_false: { \fi: } }
        { \cs_end: }
        { \cs_end: }
    }
  \cs_new_protected:Npn \@@_file_write_stop:N #1
    {
      \bool_if:NT \l_@@_writable_bool
        { \iow_close:N \l_@@_file_write_iow }
      \use:e
        {
          \group_end:
          \bool_if:NT \l_@@_storing_bool
            {
              \tl_set:Nn \exp_not:N #1
                {
                  \exp_args:NV
                    \@@_remove_leading_nl:n \l_@@_save_every_body_lines_tl
                }
            }
        }
    }
  \cs_new:Npn \@@_remove_leading_nl:n #1
    {
      \tl_if_head_is_N_type:nTF {#1}
        {
          \exp_args:Nf
            \@@_remove_leading_nl:nn
              { \tl_head:n {#1} } {#1}
        }
        { \exp_not:n {#1} }
    }
  \cs_new:Npn \@@_remove_leading_nl:nn #1 #2
    {
      \token_if_eq_meaning:NNTF ^^J #1
        { \exp_not:o { \@@_remove_leading_nl:w #2 } }
        { \exp_not:n {#2} }
    }
  \cs_new:Npn \@@_remove_leading_nl:w ^^J { }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_verb_processor_output:n, \@@_verb_processor_output:e}
%   The function \myhlc|\@@_verb_processor_output:n| does the output of
%   each line read, to the token list and to the \mymeta{output file},
%   according to the booleans \myhlc|\l_@@_writable_bool| and
%   \myhlc|\l_@@_storing_bool|.
%    \begin{macrocode}
  \cs_new_protected:Npn \@@_verb_processor_output:n #1
    {
      \bool_if:NT \l_@@_writable_bool
        { \iow_now:Nn \l_@@_file_write_iow {#1} }
      \bool_if:NT \l_@@_storing_bool
        { \tl_put_right:Nn \l_@@_save_every_body_lines_tl { ^^J #1 } }
    }
\group_end:
\cs_generate_variant:Nn \@@_verb_processor_output:n { e }
\cs_generate_variant:Nn \@@_file_tl_write_start:n { V }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]
%   {
%     \@@_analyse_nesting:n,
%     \@@_nesting_incr:,
%     \@@_nesting_decr:,
%   }
% \begin{macro}[int,TF]{\@@_if_nested:}
%   The function \myhlc|\@@_analyse_nesting:n| scans the nested
%   |\begin{scontents}| in a line and steps the counter
%   \myhlc|\l_@@_nesting_env_int|, issuing the \enquote{warning}
%   |multiple-begin| if there is more than one. The conditional
%   \myhlc|\@@_if_nested:TF| tests if we are in a nested environment and
%   \myhlc|\@@_nesting_decr:| reduces the nesting level when an
%   |\end{scontents}| is found.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_analyse_nesting:n #1
  {
    \int_zero:N \l_@@_nesting_aux_int
    \@@_analyse_nesting_format:n {#1}
    \int_compare:nNnT { \l_@@_nesting_aux_int } > { 1 }
      { \msg_warning:nn { scontents } { multiple-begin } }
  }
\cs_new_protected:Nn \@@_nesting_incr:
  {
    \int_incr:N \l_@@_nesting_env_int
    \int_incr:N \l_@@_nesting_aux_int
  }
\cs_new_protected:Nn \@@_nesting_decr:
  {
    \int_decr:N \l_@@_nesting_env_int
  }
\prg_new_protected_conditional:Npnn \@@_if_nested: { TF }
  {
    \int_compare:nNnTF { \l_@@_nesting_env_int } > { \c_zero_int }
      { \prg_return_true: }
      { \prg_return_false: }
  }
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{important}*
%   Multiple |\end{scontents}| on the same line are NOT supported.
% \end{important}
%
% \begin{macro}[int]
%   {
%     \@@_analyse_nesting_latex:n,
%     \@@_analyse_nesting_latex:w,
%     \@@_analyse_nesting_generic:nn,
%     \@@_analyse_nesting_generic:w,
%     \@@_analyse_nesting_generic_process:nn,
%     \@@_define_generic_nesting_function:n,
%     \@@_analyse_nesting_format:n,
%   }
%   In \LaTeX{} the environments start with |\begin{<env>}| and no `|}|'
%   can appear inside |<env>|, so a macro delimited by `|}|' is enough to
%   find the nested |\begin{scontents}|.
%    \begin{macrocode}
\use:e
  {
    \cs_new_protected:Npn \exp_not:N \@@_analyse_nesting_latex:w #1
      \c_backslash_str begin \c_left_brace_str #2 \c_right_brace_str
  }   {
        \@@_tl_if_head_is_q_mark:nTF {#2}
          { \@@_use_none_delimit_by_q_stop:w }
          {
            \str_if_eq:VnT \l_@@_env_name_tl {#2}
              { \@@_nesting_incr: }
            \@@_analyse_nesting_latex:w
          }
      }
\cs_new_protected:Npe \@@_analyse_nesting_latex:n #1
  {
    \@@_analyse_nesting_latex:w #1
      \c_backslash_str begin
        \c_left_brace_str \exp_not:N \q_@@_mark \c_right_brace_str
    \exp_not:N \q_@@_stop
  }
%    \end{macrocode}
%   In the other formats there is no \enquote{end anchor} to delimit the
%   name of the environment, so we search for the whole command that
%   starts the environment, |\scontents| or |\startscontents|.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_analyse_nesting_generic_process:nn #1 #2
  {
    \tl_if_head_is_N_type:nTF {#2}
      {
        \@@_tl_if_head_is_q_mark:nF {#2}
          {
            \@@_nesting_incr:
            \@@_analyse_nesting_generic:w #2 \q_@@_stop
          }
      }
      { \@@_analyse_nesting_generic:w #2 \q_@@_stop }
  }
\cs_new_protected:Npn \@@_analyse_nesting_generic:nn #1 #2
  {
    \@@_define_generic_nesting_function:n {#1}
    \use:e
      {
        \exp_not:N \@@_analyse_nesting_generic:w #2
          \c_backslash_str #1 \tl_use:N \l_@@_env_name_tl
            \exp_not:N \q_@@_mark \exp_not:N \q_@@_stop
      }
  }
\cs_new_protected:Npn \@@_define_generic_nesting_function:n #1
  {
    \use:e
      {
        \cs_set_protected:Npn \exp_not:N \@@_analyse_nesting_generic:w ##1
          \c_backslash_str #1 \tl_use:N \l_@@_env_name_tl
            ##2 \exp_not:N \q_@@_stop
      }   { \@@_analyse_nesting_generic_process:nn {##1} {##2} }
  }
%</core>
%    \end{macrocode}
%   The function \myhlc|\@@_analyse_nesting_format:n| uses the version
%   for the current format.
%    \begin{macrocode}
%<*loader>
%<latex>\cs_new_eq:NN \@@_analyse_nesting_format:n
%<latex>  \@@_analyse_nesting_latex:n
%<!latex>\cs_new_protected:Npn \@@_analyse_nesting_format:n
%<plain>  { \@@_analyse_nesting_generic:nn { } }
%<context>  { \@@_analyse_nesting_generic:nn { start } }
%</loader>
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_generic_begin:, \@@_generic_end:}
%   The function \myhlc|\@@_generic_begin:| leaves the `|^^M|' character
