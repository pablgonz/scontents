% \begin{macro}[int,TF]{\@@_tl_if_head_is_q_mark:n}
%   The conditional \myhlc|\@@_tl_if_head_is_q_mark:nTF| tests if the head
%   of the token list is \myhlc|\q_@@_mark|.
%    \begin{macrocode}
\prg_new_protected_conditional:Npnn \@@_tl_if_head_is_q_mark:n #1
  { F, TF }
  {
    \exp_after:w \if_meaning:w
      \exp_after:w
        \q_@@_mark \@@_use_i_delimit_by_s_stop:nw #1 ? \s_@@_stop
      \prg_return_true:
    \else:
      \prg_return_false:
    \fi:
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_remove_trailing_eol:N, \@@_remove_trailing_eol:w}
%   The function \myhlc|\@@_remove_trailing_eol:N| removes the string
%   \myhlc|\c_@@_hidden_space_str| from the end of the token list passed in
%   |#1|. It is used by |\typestored| (\S\ref{cmd:typestored}) and
%   |\mergesc| (\S\ref{cmd:mergesc}).
%    \begin{macrocode}
\cs_new_protected:Npe \@@_remove_trailing_eol:N #1
  {
    \exp_not:N \exp_after:w \exp_not:N \@@_remove_trailing_eol:w
      #1 \s_@@_stop \c_@@_hidden_space_str \s_@@_stop \s_@@_mark #1
  }
\use:e
  {
    \cs_new_protected:Npn \exp_not:N \@@_remove_trailing_eol:w #1
        \c_@@_hidden_space_str \s_@@_stop #2 \s_@@_mark #3
  }   {
        \tl_set:Ne #3
          {
            \tl_if_empty:nTF {#2}
              { \exp_not:o { \@@_use_delimit_by_s_stop:nw #1 } }
              { \exp_not:n {#1} }
          }
      }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int,TF]{\@@_file_if_writable:n}
%   The conditional \myhlc|\@@_file_if_writable:nTF| tests if the
%   \mymeta{output file} passed in |#1| can be written, according to the
%   \mykey{write-env}, \mykey{write-cmd}, \mykey{write-out} and
%   \mykey{overwrite} keys, and issues the messages for writing files
%   (\S\ref{subsec:general-messages}). The \mymeta{output file} is
%   searched with \myhlc|\@@_file_if_exist:nTF|.
%    \begin{macrocode}
\prg_new_protected_conditional:Npnn \@@_file_if_writable:n #1 { T, TF }
  {
    \bool_if:NTF \l_@@_writing_bool
      {
        \@@_file_if_exist:nTF {#1}
          {
            \bool_if:NTF \l_@@_overwrite_bool
              {
                \msg_info:nne { scontents } { overwrite-file } {#1}
                \prg_return_true:
              }
              {
                \msg_warning:nne { scontents } { not-writing } {#1}
                \prg_return_false:
              }
          }
          {
            \msg_info:nne { scontents } { writing-file } {#1}
            \prg_return_true:
          }
      }
      { \prg_return_false: }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_file_write_cmd:nn, \@@_file_write_cmd:VV}
%   The function \myhlc|\@@_file_write_cmd:nn| writes the content passed
%   in |#2| to the \mymeta{output file} passed in |#1|, it is used by the
%   commands.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_file_write_cmd:nn #1 #2
  {
    \@@_file_if_writable:nT {#1}
      {
        \iow_open:Nn \l_@@_file_write_iow {#1}
        \iow_now:Nn  \l_@@_file_write_iow {#2}
        \iow_close:N \l_@@_file_write_iow
      }
  }
\cs_generate_variant:Nn \@@_file_write_cmd:nn { VV }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_set_write_out:n, \@@_set_write_store:n}
%   The function \myhlc|\@@_set_write_out:n| sets the name of the
%   \mymeta{output file} passed in |#1| and only writes the content, it is
%   used by the \mykey{write-out} key. The function
%   \myhlc|\@@_set_write_store:n| also stores the content, it is used by
%   the \mykey{write-env} and \mykey{write-cmd} keys
%   (\S\ref{key:newenvsc},~\S\ref{key:Scontents},~\S\ref{key:typemeaning}).
%    \begin{macrocode}
\cs_new_protected:Npn \@@_set_write_out:n #1
  {
    \bool_set_false:N \l_@@_storing_bool
    \bool_set_true:N \l_@@_writing_bool
    \tl_set:Nn \l_@@_file_name_tl {#1}
  }
\cs_new_protected:Npn \@@_set_write_store:n #1
  {
    \@@_set_write_out:n {#1}
    \bool_set_true:N \l_@@_storing_bool
  }
%    \end{macrocode}
% \end{macro}
