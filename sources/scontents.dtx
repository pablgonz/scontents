% \section{Implementation}\label{sec:implementation}
% \addtocontents{toc}{\protect\setcounter{tocdepth}{0}}
%
% The most recent publicly released version of \mypkg*[no-index]{scontents}
% is available at \textsc{ctan}: \url{https://www.ctan.org/pkg/scontents}.
% Historical and developmental versions are available at
% \textcolor{gray}{\scriptsize\faIcon[regular]{github}}
% \url{https://github.com/pablgonz/scontents}. While general feedback via
% email is welcomed, specific bugs or feature requests should be reported
% through the issue tracker:
% \url{https://github.com/pablgonz/scontents/issues}.
%
% \begin{important}*
% All variables and functions defined in this package are private and
% are NOT intended to work or be used by another package or module.
% \end{important}
%
% \subsection{General conventions}\label{subsec:conventions}
%
% The package is split into a \emph{loader} and a \emph{core}. The loader
% is different for each format and generates \myfile{scontents.sty} for
% \hologo{LaTeX}, \myfile{scontents.tex} for \hologo{plainTeX} and
% \myfile{t-scontents.mkiv} for \hologo{ConTeXt}, the core is shared by
% the three formats and generates \myfile{scontents-code.tex}, which is
% loaded by each loader.
%
% Since the core runs in \hologo{plainTeX} and \hologo{ConTeXt}, where
% the names of some primitives may be redefined by the format, the core
% uses the \myhlc|\tex_...:D| names for the primitives that have no
% \pkg{expl3} interface, such as \myhlc|\tex_kern:D|,
% \myhlc|\tex_lastskip:D| or \myhlc|\tex_spacefactor:D|.
%
% Each command and environment is implemented in the same order: its
% variables, its messages, its \mymeta{keys}, its internal functions and
% finally the public command or environment.
%
% \subsection{Declaration of the package}
%
% First we set up the module name for \pkg{DocStrip} \pkg{l3doc} class:
%    \begin{macrocode}
%<@@=scontents>
%    \end{macrocode}
%
% Now we define some common macros to hold the package date and version:
%    \begin{macrocode}
%<*loader>
\def\ScontentsFileDate{2026-11-01}%
\def\ScontentsFileVersion{2.8}%
\def\ScontentsFileDescription{Stores LaTeX contents in memory or files}%
%    \end{macrocode}
%
% The \LaTeX{} loader is quite simple, we just need to make sure of the
% minimum version for correct operation and then set interfaces up.
% The choice of \LaTeX{} release 2026-06-01 is the latest available in
% \TeX{} Live 2026 and is necessary to be able to implement
% the package's full compatibility with \emph{tagged} \texttt{PDF}.
%
%    \begin{macrocode}
%<*latex>
\NeedsTeXFormat{LaTeX2e}[2026-06-01]
\ProvidesExplPackage
  {scontents} {\ScontentsFileDate} {\ScontentsFileVersion}
  {\ScontentsFileDescription}
%</latex>
%    \end{macrocode}
%
% \subsubsection{Load \texttt{expl3-generic} and \texttt{xparse-generic} in \hologo{plainTeX} and \hologo{ConTeXt}}\label{subsubsec:generic-layer}
%
% \begin{macro}[int]
%   {
%     \c_@@_version_str,
%     \l_@@_char_value_int,
%   }
%   The \hologo{plainTeX} and \hologo{ConTeXt} loaders are similar. We
%   define the constant string \myhlc|\c_@@_version_str| with the version
%   info and add |\ExplSyntaxOn| to be able to load the frozen
%   \mypkg{xparse}\cite{xparse}. In \hologo{ConTeXt} the module is loaded
%   after \myhlc|\unprotect|, which makes `|!|' a letter, but
%   \mypkg{expl3} and \myfile{xparse-generic.tex} use `|!|' in boolean
%   expressions and \myfile{expl3-generic.tex} does not set its category
%   code, so `|!|' is set to \emph{other} before loading it and is a
%   letter again at the end (\S\ref{subsec:finish}).
%    \begin{macrocode}
%<*!latex>
%<context>\writestatus{loading}{User Module scontents v\ScontentsFileVersion}
%<context>\unprotect
%<context>\catcode`\!=12\relax
\input expl3-generic.tex
\ExplSyntaxOn
\str_const:ce { c_@@_version_str } { \ScontentsFileDate\space
  v\ScontentsFileVersion\space \ScontentsFileDescription }
\iow_log:e { Package: ~ scontents ~ \str_use:c { c_@@_version_str } }
%    \end{macrocode}
%   Outside of \LaTeX{} we can't use \mypkg{ltcmd}\cite{latex2e,userguide},
%   part of the \LaTeX{} kernel, but the old \mypkg{xparse}\cite{xparse}
%   provides \myfile{xparse-generic.tex}, which is loadable in any format.
%   The integer variable \myhlc|\l_@@_char_value_int| saves the category code
%   of `|@|' while it is loaded.
%    \begin{macrocode}
\int_new:N  \l_@@_char_value_int
\int_set:Nn \l_@@_char_value_int { \char_value_catcode:n { `\@ } }
\char_set_catcode_letter:N \@
\file_input:n { xparse-generic.tex }
\char_set_catcode:nn { `\@ } { \l_@@_char_value_int }
%</!latex>
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{Checking \texttt{expl3} version}
%
% For \hologo{plainTeX}, \hologo{LaTeX} and \hologo{ConTeXt} we must check
% the minimum requirement, in this case \myhlc|\tl_retokenize:n| which
% was added in release 2025-07-08 of \mypkg{expl3} included in
% \hologo{TeX} Live 2025.
%    \begin{macrocode}
\cs_if_exist:NF \tl_retokenize:n
  {
    \msg_new:nnn { scontents } { expl-too-old }
      {
        Please~install~an~up~to~date~TeX~distribution~or~update~using~
        your~TeX~package~manager~or~from~CTAN. \\
        See~documentation.~Loading~scontents~will~abort!
      }
    \msg_fatal:nn { scontents } { expl-too-old }
    \ExplSyntaxOff
    \file_input_stop:
  }
%    \end{macrocode}
%
% \subsubsection{Preventing double loading in \hologo{plainTeX}}
%
% In \hologo{plainTeX}, check that the package isn't being loaded twice,
% \LaTeX{} and \hologo{ConTeXt} already defend against that:
%    \begin{macrocode}
%<*plain>
\tl_if_exist:NT \l_@@_cmd_name_tl
  {
    \msg_new:nnn { scontents } { already-loaded }
      {
        The~'scontents'~package~is~already~loaded.~
        Aborting~input~\msg_line_context:.
      }
    \msg_warning:nn { scontents } { already-loaded }
    \ExplSyntaxOff
    \file_input_stop:
  }
%</plain>
%</loader>
%    \end{macrocode}
%
% \subsubsection{Checking proper loader}
%
% Checking that the package was loaded with the proper loader code. This code
% was copied from \myfile{expl3-code.tex}.
%    \begin{macrocode}
%<*core>
\def\ScontentsCoreFileDate{2026-11-01}%
\begingroup
  \catcode32=10
  \endlinechar=32
  \def\next{\endgroup}%
  \expandafter\ifx\csname PackageError\endcsname\relax
    \begingroup
      \def\next{\endgroup\endgroup}%
      \def\PackageError#1#2#3%
        {%
          \endgroup
          \errhelp{#3}%
          \errmessage{#1 Error: #2!}%
        }%
  \fi
  \expandafter\ifx\csname ScontentsFileDate\endcsname\relax
    \def\next
      {%
        \PackageError{scontents}{No scontents loader detected}
          {%
            You have attempted to use the scontents code directly rather
            than using the correct loader. Loading of scontents will abort.
          }%
        \endgroup
        \endinput
      }%
  \else
    \ifx\ScontentsFileDate\ScontentsCoreFileDate
    \else
      \def\next
        {%
          \PackageError{scontents}{Mismatched scontents files detected}
            {%
              You have attempted to load scontents with mismatched files:
              probably you have one or more files 'locally installed' which
              are in conflict. Loading of scontents will abort.
            }%
          \endgroup
          \endinput
        }%
    \fi
  \fi
\next
%</core>
%    \end{macrocode}
%
% \subsection{Variables and functions by format}\label{subsec:format}
%
% We define and set the variables and the function that must be handled
% separately in order to work properly with \hologo{plainTeX}, \LaTeX{} and
% \hologo{ConTeXt}.
%
% \begin{macro}[int]{\@@_format_case:nnn}
%   The function \myhlc|\@@_format_case:nnn| leaves the argument for the
%   current format: |#1| for \LaTeX, |#2| for \hologo{plainTeX} and |#3| for
%   \hologo{ConTeXt}.
%    \begin{macrocode}
%<*loader>
\cs_new:Npn \@@_format_case:nnn #1 #2 #3
%<latex>  {#1} % LaTeX
%<plain>  {#2} % Plain/Generic
%<context>  {#3} % ConTeXt
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int,TF]{\@@_file_if_exist:n}
%   The conditional \myhlc|\@@_file_if_exist:nTF| tests if the
%   \mymeta{output file} passed in |#1| exists in the working directory.
%   In \hologo{LaTeX} and \hologo{plainTeX} it is
%   \myhlc|\file_if_exist:nTF|. In \hologo{ConTeXt} the file search keeps
%   the result found at the start of the run, so a file written by the
%   package in the same run is not found; there the test is done with
%   |lfs.isfile| of \hologo{LuaTeX}, the \mymeta{output file} is always
%   in the working directory.
%    \begin{macrocode}
%<!context>\cs_new_eq:NN \@@_file_if_exist:nTF \file_if_exist:nTF
%<*context>
\prg_new_conditional:Npnn \@@_file_if_exist:n #1 { TF }
  {
    \str_if_eq:eeTF
      {
        \lua_now:e
          { tex.write(lfs.isfile("\lua_escape:e {#1}")~and~"1"~or~"0") }
      }
      { 1 }
      { \prg_return_true: }
      { \prg_return_false: }
  }
%</context>
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\c_@@_newline_tl}
%   The constant token list \myhlc|\c_@@_newline_tl| stores the character
%   `|^^J|' used as end of line in the \mymeta{stored content}.
%    \begin{macrocode}
%<*!context>
\tl_const:Ne \c_@@_newline_tl { \iow_char:N \^^J }
%</!context>
%    \end{macrocode}
%   In \hologo{ConTeXt} the package does not work under LMTX, so loading
%   is aborted there. The test with \myhlc|\contextlmtxmode| is adapted
%   from the file \myfile{t-lua-widow-control.mkxl} of Max Chernoff's
%   \mypkg{lua-widow-control} package, \myhlc|\contextlmtxmode| is
%   described in \url{https://source.contextgarden.net/tex/context/base/mkxl/context.mkxl}.
%    \begin{macrocode}
%<*context>
\bool_if:NTF \contextlmtxmode
  {
    \msg_new:nnn { scontents } { luametatex }
      {
        The~'scontents'~package~doesn't~work~under~LMTX.
      }
    \msg_fatal:nn { scontents } { luametatex }
  }
  {
    \tl_const:Ne \c_@@_newline_tl { \iow_char:N \^^J }
  }
%</context>
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]
%   {
%     \g_@@_end_verbatimsc_tl,
%     \c_@@_end_env_tl,
