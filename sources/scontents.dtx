% \subsubsection{Functions for \texttt{TAB} and \texttt{verbatimsc}}
%
% \begin{macro}[int]{\@@_tab:, \@@_par:}
%   Control sequences to replace the tab `|^^I|' and form feed `|^^L|'
%   characters.
%    \begin{macrocode}
\cs_new:Ne \@@_tab: { \c_space_tl }
\cs_new:Nn \@@_par: { ^^J ^^J }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_tabs_to_spaces:}
%   In a \emph{verbatim} context the \texttt{TAB} character is made active
%   and set equal to \myhlc|\@@_tabs_to_spaces:|, to produce as many spaces
%   as the \mykey{width-tab} key was set to. The spaces are \emph{active}
%   characters, the same as the spaces of the \emph{verbatim} context: a
%   space token at the beginning of a line would be dropped in vertical
%   mode and the \texttt{TAB} that indent a line would be lost. The
%   \emph{active} space is made with \myhlc|\tex_lowercase:D| from the
%   \emph{active} character `|^^@|', since \myhlc|\char_generate:nn|
%   would expand it while defining the function.
%    \begin{macrocode}
\group_begin:
  \char_set_catcode_active:N \^^@
  \char_set_lccode:nn { 0 } { 32 }
  \tex_lowercase:D
    {
      \group_end:
      \cs_new:Npn \@@_tabs_to_spaces:
        { \prg_replicate:nn { \l_@@_tab_width_int } { ^^@ } }
    }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_do_noligs:N}
%   The function \myhlc|\@@_do_noligs:N| is an alternative definition for
%   \LaTeXe's \myhlc|\do@noligs| which makes sure to not consume the
%   following space tokens. The \LaTeXe{} version ends with
%   \myhlc|\char`#1|, which leaves \TeX{} still looking for an
%   \mymeta{optional~space}.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_do_noligs:N #1
  {
    \char_set_catcode_active:N #1
    \cs_set:cpe { @@_active_char_ \token_to_str:N #1 : }
      {
        \mode_leave_vertical:
        \tex_kern:D \c_zero_dim
        \tex_char:D `\exp_not:N #1
      }
    \char_set_active_eq:Nc #1 { @@_active_char_ \token_to_str:N #1 : }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]
%   {
%     \@@_set_active_eq:NN,
%     \@@_plain_disable_outer_par:,
%     \@@_make_control_chars_active:,
%   }
%   Shortcut definitions for common catcode changes. The `|^^L|' needs a
%   special treatment in \hologo{plainTeX} because it is an
%   \myhlc|\outer| token there.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_set_active_eq:NN #1
  {
    \char_set_catcode_active:N #1
    \char_set_active_eq:NN #1
  }
%</core>
%<*loader>
\group_begin:
%<plain>  \char_set_catcode_active:n { `\* }
  \cs_new_protected:Nn \@@_plain_disable_outer_par:
%<*plain>
    {
      \group_begin:
        \char_set_lccode:nn { `\* } { `\^^L }
        \tex_lowercase:D { \group_end:
        \tex_let:D * \scan_stop:
      }
    }
%</plain>
%<latex|context>    { }
\group_end:
%</loader>
%<*core>
\cs_new_protected:Nn \@@_make_control_chars_active:
  {
    \@@_plain_disable_outer_par:
    \@@_set_active_eq:NN \^^I \@@_tab:
    \@@_set_active_eq:NN \^^L \@@_par:
    \@@_set_active_eq:NN \^^M \@@_ret:w
  }
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{Functions \cs[no-index]{@bsphack} and \cs[no-index]{@esphack}}\label{fun:sphack}
%
% \begin{macro}[int]{\@@_bsphack:, \@@_esphack:}
%   We emulate \myhlc|\@bsphack| and \myhlc|\@esphack| for \hologo{plainTeX}
%   and \hologo{ConTeXt}, this is necessary to prevent \emph{unwanted
%   spaces} when the \mykey{print-cmd} key is false. In \LaTeX{} the
%   kernel definitions are used.
%    \begin{macrocode}
\cs_new_protected:Nn \@@_bsphack:
  {
    \scan_stop:
    \mode_if_horizontal:T
      {
        \skip_set_eq:NN \l_@@_save_skip \tex_lastskip:D
        \int_set_eq:NN \l_@@_save_sf_int \tex_spacefactor:D
      }
  }
\cs_new_protected:Nn \@@_esphack:
  {
    \scan_stop:
    \mode_if_horizontal:T
      {
        \int_set_eq:NN \tex_spacefactor:D \l_@@_save_sf_int
        \dim_compare:nNnT { \l_@@_save_skip } > { \c_zero_skip }
          {
            \skip_if_eq:nnT { \tex_lastskip:D } { \c_zero_skip }
              {
                \nobreak
                \skip_horizontal:n { \c_zero_skip }
              }
            \tex_ignorespaces:D
          }
      }
  }
%</core>
%<*latex>
\cs_gset_eq:NN \@@_bsphack: \@bsphack
\cs_gset_eq:NN \@@_esphack: \@esphack
%</latex>
%    \end{macrocode}
% \end{macro}
%
% \subsection{Functions for sequences}\label{fun:sequences}
%
% The \emph{storage system} of the package \mypkg*[no-index]{scontents} is
% done using |seq| variables. Here we set up the functions that manage them.
%
% \begin{macro}[int]{\@@_append_contents:nn, \@@_append_contents:Ve}
%   The function \myhlc|\@@_append_contents:nn| creates the \emph{sequence}
%   passed in |#1| if it does not exist and appends the \mymarg{body env}
%   of an environment or the \mymarg{argument} of a command, passed in
%   |#2|, to the right of the \emph{sequence}.
%    \begin{macrocode}
%<*core>
\cs_new_protected:Npn \@@_append_contents:nn #1 #2
  {
    \seq_if_exist:cF { g_@@_name_#1_seq }
      { \seq_new:c { g_@@_name_#1_seq } }
    \seq_gput_right:cn { g_@@_name_#1_seq } {#2}
  }
\cs_generate_variant:Nn \@@_append_contents:nn { Ve }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_store_to_seq:NN}
%   The function \myhlc|\@@_store_to_seq:NN| writes the recorded content
%   in |#1| to the \texttt{.log} file if \mykey{debug-var} is true and
%   stores it in the \emph{sequence} named by |#2|.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_store_to_seq:NN #1 #2
  {
    \bool_if:NT \l_@@_debug_var_bool
      {
        \tl_log:N #1
      }
    \@@_append_contents:Ve #2 { \exp_not:V #1 }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_finish_storing:NNN}
%   The function \myhlc|\@@_finish_storing:NNN| works only in the
%   \emph{storing mode}, when the \mykey{write-out} key is not active. If
%   the key \mykey{force-eol} is false, its default value,
%   \myhlc|\c_@@_hidden_space_str| is added to the end of the token list
%   passed in |#1|, which contains the \mymarg{body env} of an environment
%   or the \mymarg{argument} of |\Scontents|.
%
%   Then \myhlc|\@@_store_to_seq:NN| stores the content in the
%   \emph{sequence} named by |#2| and, if the boolean passed in |#3|, set
%   by the \mykey{print-env} or \mykey{print-cmd} key, is true, the content
%   is printed from the \emph{sequence} by \myhlc|\@@_lastfrom_seq:V|. If
%   the \emph{name} of the \emph{sequence} is blank, the \enquote{error}
%   |empty-store-name| is raised and nothing is stored or printed.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_finish_storing:NNN #1 #2 #3
  {
    \bool_if:NT \l_@@_storing_bool
      {
        \tl_if_blank:VTF #2
          { \msg_error:nn { scontents } { empty-store-name } }
          {
            \bool_if:NF \l_@@_forced_eol_bool
              { \tl_put_right:Ne #1 { \c_@@_hidden_space_str } }
            \@@_store_to_seq:NN #1 #2
            \bool_if:NT #3 { \@@_lastfrom_seq:V #2 }
          }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_seq_count:n, \@@_seq_item:nn}
% \begin{macro}[int,TF]{\@@_seq_if_exist:n}
%   A \emph{sequence} set by the \mykey{remember} key has a second copy
%   with the \mymeta{stored contents} of the previous compilation, whose
%   name uses |prev| instead of |name| (\S\ref{subsec:remember}). The
%   conditional \myhlc|\@@_seq_if_exist:nTF| tests if any of the two
%   \emph{sequences} named by |#1| exists, the function
%   \myhlc|\@@_seq_count:n| returns the larger number of
%   \mymeta{stored contents} of the two, or |0| if none exists, and the
%   function \myhlc|\@@_seq_item:nn| returns the \mymeta{stored content}
%   at the \mymeta{index} passed in |#2|, from the previous compilation
%   if it has it and from the current one otherwise. Without
%   \mykey{remember}, and always in \hologo{plainTeX} and
%   \hologo{ConTeXt}, only the current \emph{sequence} exists.
%    \begin{macrocode}
\prg_new_conditional:Npnn \@@_seq_if_exist:n #1 { TF }
  {
    \bool_lazy_or:nnTF
      { \seq_if_exist_p:c { g_@@_name_#1_seq } }
      { \seq_if_exist_p:c { g_@@_prev_#1_seq } }
      { \prg_return_true: }
      { \prg_return_false: }
  }
\cs_new:Npn \@@_seq_count:n #1
  {
    \int_max:nn
      {
        \seq_if_exist:cTF { g_@@_name_#1_seq }
          { \seq_count:c { g_@@_name_#1_seq } }
          { 0 }
      }
      {
        \seq_if_exist:cTF { g_@@_prev_#1_seq }
          { \seq_count:c { g_@@_prev_#1_seq } }
          { 0 }
      }
  }
\cs_new:Npn \@@_seq_item:nn #1 #2
  {
    \bool_lazy_and:nnTF
      { \seq_if_exist_p:c { g_@@_prev_#1_seq } }
      {
        \int_compare_p:nNn { \int_abs:n {#2} }
          < { \seq_count:c { g_@@_prev_#1_seq } + 1 }
      }
      { \seq_item:cn { g_@@_prev_#1_seq } {#2} }
      { \seq_item:cn { g_@@_name_#1_seq } {#2} }
  }
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}[int]
%   {
%     \@@_getfrom_seq:Nn,
%     \@@_getfrom_seq:nNn,
%     \@@_getfrom_seq_aux:nnn,
%     \@@_getfrom_seq:nn,
%     \@@_getfrom_seq:nnn,
%   }
%   The function \myhlc|\@@_getfrom_seq:Nn| retrieves the
%   \mymeta{stored contents} whose \mymeta{indexes} are in the sequence
%   passed in |#1| from the \emph{sequence} named by |#2| and the function
%   \myhlc|\@@_getfrom_seq:nn| retrieves the one whose \mymeta{index} is
%   passed in |#1|, both with \myhlc|\@@_seq_item:nn|. Both raise the
%   \enquote{errors} |undefined-storage| and |index-out-of-range|
%   (\S\ref{subsec:general-messages}).
%    \begin{macrocode}
\cs_new:Npn \@@_getfrom_seq:Nn #1 #2
  {
    \@@_seq_if_exist:nTF {#2}
      {
        \exp_args:Nf \@@_getfrom_seq:nNn
          { \@@_seq_count:n {#2} } #1 {#2}
      }
      { \msg_expandable_error:nnn { scontents } { undefined-storage } {#2} }
  }
\cs_new:Npn \@@_getfrom_seq:nNn #1 #2 #3
  {
    \seq_map_tokens:Nn #2 { \@@_getfrom_seq_aux:nnn {#1} {#3} }
  }
\cs_new:Npn \@@_getfrom_seq_aux:nnn #1 #2 #3
  {
    \exp_args:Nnf \use:n
      { \@@_getfrom_seq:nnn {#1} } { \int_eval:n {#3} } {#2}
  }
\cs_new:Npn \@@_getfrom_seq:nn #1 #2
  {
    \@@_seq_if_exist:nTF {#2}
      {
        \exp_args:Nf \@@_getfrom_seq:nnn
          { \@@_seq_count:n {#2} }
          {#1} {#2}
      }
      { \msg_expandable_error:nnn { scontents } { undefined-storage } {#2} }
  }
\cs_new:Npn \@@_getfrom_seq:nnn #1 #2 #3
  {
    \bool_lazy_or:nnTF
      { \int_compare_p:nNn {#2} = { 0 } }
      { \int_compare_p:nNn { \int_abs:n {#2} } > {#1} }
      {
        \msg_expandable_error:nnnnn { scontents } { index-out-of-range }
          {#2} {#3} {#1}
      }
      { \@@_seq_item:nn {#3} {#2} }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@@_lastfrom_seq:n, \@@_lastfrom_seq:V}
%   The function \myhlc|\@@_lastfrom_seq:n| saves the last
%   \mymeta{stored content} of the \emph{sequence} named by |#1| in
%   \myhlc|\g_@@_last_stored_tl| and rescans it with
%   \myhlc|\tl_retokenize:V| after the group, when the keys
%   \mykey{print-env} or \mykey{print-cmd} are active.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_lastfrom_seq:n #1
  {
    \tl_gset:Ne \g_@@_last_stored_tl
      {
        \seq_item:cn { g_@@_name_#1_seq } { -1 }
      }
    \group_insert_after:N \tl_retokenize:V
    \group_insert_after:N \g_@@_last_stored_tl
    \group_insert_after:N \tl_gclear:N
    \group_insert_after:N \g_@@_last_stored_tl
  }
\cs_generate_variant:Nn \@@_lastfrom_seq:n { V }
%</core>
%    \end{macrocode}
% \end{macro}
%
% \subsection{Remembering contents between compilations}\label{subsec:remember}
%
% The \mykey{remember} key (\S\ref{key:package}) makes the
% \mymeta{stored contents} of some \emph{sequences} available before they
% are stored, as |\label| and |\ref| do with the references. At the end
% of the document the \mymeta{stored contents} of these \emph{sequences}
% are written to the file |\jobname.sct| and at the beginning of
% the next compilation they are read in a second \emph{sequence}, that
% is used by \myhlc|\@@_seq_item:nn| (\S\ref{fun:sequences}). Each line
% of the file has the name of the \emph{sequence} and one
% \mymeta{stored content}, both converted to hexadecimal digits and
% separated by `|=|', so that any character can be written and read
% again. This is only available in \hologo{LaTeX}.
%
% \subsubsection{Definition of variables for remembering contents}
%
% \begin{macro}[int]{\g_@@_remember_seq, \g_@@_remember_pending_bool}
%   The global \emph{sequence} \myhlc|\g_@@_remember_seq| stores, as
%   strings, the names of the \emph{sequences} set by the
%   \mykey{remember} key and the boolean
%   \myhlc|\g_@@_remember_pending_bool| is true when a
%   \mymeta{stored content} of one of them is requested and it is not
%   available yet.
%    \begin{macrocode}
%<*core>
\seq_new:N \g_@@_remember_seq
\bool_new:N \g_@@_remember_pending_bool
%</core>
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]
%   {
%     \g_@@_remember_ior,
%     \g_@@_remember_iow,
%     \g_@@_remember_old_str,
%     \l_@@_remember_new_str,
%     \l_@@_remember_name_str,
%     \l_@@_remember_item_str,
%   }
%   The streams \myhlc|\g_@@_remember_ior| and \myhlc|\g_@@_remember_iow|
%   read and write the file |\jobname.sct|. The string
%   \myhlc|\g_@@_remember_old_str| saves the lines read from the file and
%   \myhlc|\l_@@_remember_new_str| the lines written, to compare them at
%   the end of the document, and the strings
%   \myhlc|\l_@@_remember_name_str| and \myhlc|\l_@@_remember_item_str|
%   save the name of the \emph{sequence} and the \mymeta{stored content}
%   of a line.
%    \begin{macrocode}
%<*latex>
\ior_new:N \g_@@_remember_ior
\iow_new:N \g_@@_remember_iow
\str_new:N \g_@@_remember_old_str
\str_new:N \l_@@_remember_new_str
\str_new:N \l_@@_remember_name_str
\str_new:N \l_@@_remember_item_str
%</latex>
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{Definition of error messages for remembering contents}
%
% \begin{macro}[int]{remember-latex-only}
%   The \enquote{error} |remember-latex-only| is raised when the
%   \mykey{remember} key is used in \hologo{plainTeX} or \hologo{ConTeXt}.
%    \begin{macrocode}
%<*core>
\msg_new:nnnn { scontents } { remember-latex-only }
  { The~key~'remember'~is~only~available~in~LaTeX~\msg_line_context:. }
  {
    The~stored~contents~can~only~be~used~after~they~are~stored~
    in~this~format.~The~key~is~ignored.
  }
%</core>
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{Definition of messages for remembering contents}
%
% \begin{macro}[int]{remember-rerun, remember-undefined}
%   The \enquote{warning} |remember-rerun| is issued at the end of the
%   document when the lines written to |\jobname.sct| are not the
%   ones read from it, and otherwise the \enquote{warning}
%   |remember-undefined| when a \mymeta{stored content} was requested and
%   it was not available.
%    \begin{macrocode}
%<*latex>
\msg_new:nnn { scontents } { remember-rerun }
  { Stored~contents~may~have~changed.~Rerun~to~get~them~right. }
\msg_new:nnn { scontents } { remember-undefined }
  { There~were~undefined~stored~contents. }
%</latex>
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{Internal functions for remembering contents}
%
% \begin{macro}[int]{\@@_remember:n}
%   The function \myhlc|\@@_remember:n|, used by the \mykey{remember}
%   key, adds each name of the comma separated list passed in |#1| to
%   \myhlc|\g_@@_remember_seq| as a string, only once. In
%   \hologo{plainTeX} and \hologo{ConTeXt} it raises the
%   \enquote{error} |remember-latex-only|.
%    \begin{macrocode}
%<*core>
\cs_new_protected:Npn \@@_remember:n #1
  {
    \@@_format_case:nnn
      {
        \clist_map_inline:nn {#1}
          {
            \seq_if_in:NeF \g_@@_remember_seq { \tl_to_str:n {##1} }
              { \seq_gput_right:Ne \g_@@_remember_seq { \tl_to_str:n {##1} } }
          }
      }
      { \msg_error:nn { scontents } { remember-latex-only } }
      { \msg_error:nn { scontents } { remember-latex-only } }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int,TF]{\@@_if_pending:n}
% \begin{macro}[int]{\@@_if_pending:neF}
%   The conditional \myhlc|\@@_if_pending:nnTF| tests if the
%   \mymeta{stored content} at the \mymeta{index} passed in |#2| of the
%   remembered \emph{sequence} named by |#1| is not available yet, that
%   is, if its absolute value is greater than the number of
%   \mymeta{stored contents} of both copies. In that case
%   \myhlc|\g_@@_remember_pending_bool| is set to true and the commands
%   print nothing. For the \emph{sequences} that are not remembered it is
%   always false and the \enquote{errors} of the commands are raised as
%   usual.
%    \begin{macrocode}
\prg_new_protected_conditional:Npnn \@@_if_pending:nn #1 #2 { T, F }
  {
    \bool_lazy_and:nnTF
      { \seq_if_exist_p:c { g_@@_prev_#1_seq } }
      { \int_compare_p:nNn { \int_abs:n {#2} } > { \@@_seq_count:n {#1} } }
      {
        \bool_gset_true:N \g_@@_remember_pending_bool
        \prg_return_true:
      }
      { \prg_return_false: }
  }
\prg_generate_conditional_variant:Nnn \@@_if_pending:nn { ne } { F }
%</core>
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}[int]
%   {
%     \@@_remember_read:,
%     \@@_remember_read_line:n,
%     \@@_remember_read_line:w,
%   }
%   The function \myhlc|\@@_remember_read:| reads the file
%   |\jobname.sct|, if it exists, line by line with
%   \myhlc|\@@_remember_read_line:n|, and creates an empty copy of the
%   remembered \emph{sequences} that are not in the file. The function
%   \myhlc|\@@_remember_read_line:w| converts the name of the
%   \emph{sequence} from hexadecimal digits and, if it is remembered,
%   saves the line in \myhlc|\g_@@_remember_old_str| and adds the
%   \mymeta{stored content}, converted from hexadecimal digits, to the
%   copy of the previous compilation. The lines of the
%   \emph{sequences} that are no longer remembered are ignored.
%    \begin{macrocode}
%<*latex>
\cs_new_protected:Npn \@@_remember_read:
  {
    \ior_open:NnT \g_@@_remember_ior { \c_sys_jobname_str .sct }
      {
        \ior_str_map_inline:Nn \g_@@_remember_ior
          { \@@_remember_read_line:n {##1} }
        \ior_close:N \g_@@_remember_ior
      }
    \seq_map_inline:Nn \g_@@_remember_seq
      {
        \seq_if_exist:cF { g_@@_prev_##1_seq }
          { \seq_new:c { g_@@_prev_##1_seq } }
      }
  }
\cs_new_protected:Npn \@@_remember_read_line:n #1
  {
    \str_if_empty:nF {#1}
      { \@@_remember_read_line:w #1 = = \s_@@_stop }
  }
\cs_new_protected:Npn \@@_remember_read_line:w #1 = #2 = #3 \s_@@_stop
  {
    \str_set_convert:Nnnn \l_@@_remember_name_str {#1} { utf8/hex } { }
    \seq_if_in:NVT \g_@@_remember_seq \l_@@_remember_name_str
      {
        \str_gput_right:Nn \g_@@_remember_old_str { #1 = #2 , }
        \str_set_convert:Nnnn \l_@@_remember_item_str {#2} { utf8/hex } { }
        \seq_if_exist:cF { g_@@_prev_ \l_@@_remember_name_str _seq }
          { \seq_new:c { g_@@_prev_ \l_@@_remember_name_str _seq } }
        \seq_gput_right:cV { g_@@_prev_ \l_@@_remember_name_str _seq }
          \l_@@_remember_item_str
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]
%   {
%     \@@_remember_write:,
%     \@@_remember_write_seq:n,
%     \@@_remember_write_item:n,
%   }
%   The function \myhlc|\@@_remember_write:| writes the file
%   |\jobname.sct| if some \emph{sequence} is remembered: for each
%   one that exists, \myhlc|\@@_remember_write_seq:n| converts its name
%   to hexadecimal digits and \myhlc|\@@_remember_write_item:n| writes a
%   line for each \mymeta{stored content}, also saved in
%   \myhlc|\l_@@_remember_new_str|. If the lines written are not the ones
%   read, the \enquote{warning} |remember-rerun| is issued, otherwise
%   |remember-undefined| if a \mymeta{stored content} was not available.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_remember_write:
  {
    \seq_if_empty:NF \g_@@_remember_seq
      {
        \str_clear:N \l_@@_remember_new_str
        \iow_open:Nn \g_@@_remember_iow { \c_sys_jobname_str .sct }
        \seq_map_function:NN \g_@@_remember_seq \@@_remember_write_seq:n
        \iow_close:N \g_@@_remember_iow
        \str_if_eq:NNTF \g_@@_remember_old_str \l_@@_remember_new_str
          {
            \bool_if:NT \g_@@_remember_pending_bool
              { \msg_warning:nn { scontents } { remember-undefined } }
          }
          { \msg_warning:nn { scontents } { remember-rerun } }
      }
  }
\cs_new_protected:Npn \@@_remember_write_seq:n #1
  {
    \seq_if_exist:cT { g_@@_name_#1_seq }
      {
        \str_set_convert:Nnnn \l_@@_remember_name_str {#1} { } { utf8/hex }
        \seq_map_function:cN { g_@@_name_#1_seq }
          \@@_remember_write_item:n
      }
  }
\cs_new_protected:Npn \@@_remember_write_item:n #1
  {
    \str_set_convert:Nnnn \l_@@_remember_item_str {#1} { } { utf8/hex }
    \iow_now:Ne \g_@@_remember_iow
      { \l_@@_remember_name_str = \l_@@_remember_item_str }
    \str_put_right:Ne \l_@@_remember_new_str
      { \l_@@_remember_name_str = \l_@@_remember_item_str , }
  }
%    \end{macrocode}
% \end{macro}
%
%   The file is read at the beginning of the document and written at the
%   end of it.
%    \begin{macrocode}
\hook_gput_code:nnn { begindocument } { scontents }
  { \@@_remember_read: }
\hook_gput_code:nnn { enddocument } { scontents }
  { \@@_remember_write: }
%</latex>
%    \end{macrocode}
%
% \subsection{The command \cs{newenvsc}}\label{cmd:newenvsc}
%
% The user-level command |\newenvsc| creates a new environment with the
% same behavior as the base environment |scontents|, which is itself
% defined with |\newenvsc| (\S\ref{env:scontents}). It takes a mandatory
% argument, the \mymarg{env name}, and an optional argument with the
% \mymeta{initial keys}. The references to |\begin{scontents}| or
% |\end{scontents}| in this section apply to any environment defined
% with |\newenvsc|.
%
% \subsubsection{Definition of variables for \cs[no-index]{newenvsc}}
%
% \begin{macro}[int]
%   {
%     \l_@@_save_every_body_lines_tl,
%     \l_@@_processed_body_lines_tl,
%     \l_@@_environment_keys_tl,
%     \l_@@_nesting_env_int,
%     \l_@@_nesting_aux_int,
%   }
%   The token list \myhlc|\l_@@_save_every_body_lines_tl| holds the
%   \mymarg{body env} of the environment while it is being read and the
%   token list \myhlc|\l_@@_processed_body_lines_tl| saves it once the
%   environment is closed. The token list
%   \myhlc|\l_@@_environment_keys_tl| saves the \mymeta{keys} passed to the
%   \emph{optional argument} and the integer variables
%   \myhlc|\l_@@_nesting_env_int| and \myhlc|\l_@@_nesting_aux_int| are
%   used to analyze the nesting of the environment.
%    \begin{macrocode}
%<*core>
\tl_new:N  \l_@@_save_every_body_lines_tl
\tl_new:N  \l_@@_processed_body_lines_tl
\tl_new:N  \l_@@_environment_keys_tl
\int_new:N \l_@@_nesting_env_int
\int_new:N \l_@@_nesting_aux_int
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{Definition of error messages for \cs[no-index]{newenvsc}}
%
% \begin{macro}[int]{\@@_env_begin_str:n, \@@_env_end_str:n}
%   The functions \myhlc|\@@_env_begin_str:n| and
%   \myhlc|\@@_env_end_str:n| return the start and the end of the
%   environment named by |#1| as they are written in each format:
%   |\begin{#1}| and |\end{#1}| in \LaTeX, |\#1| and |\end#1| in
%   \hologo{plainTeX} and |\start#1| and |\stop#1| in \hologo{ConTeXt}.
%   They are used in the messages of the environments.
%    \begin{macrocode}
\cs_new:Npn \@@_env_begin_str:n #1
  {
    \@@_format_case:nnn
      { \c_backslash_str begin \c_left_brace_str #1 \c_right_brace_str }
      { \c_backslash_str #1 }
      { \c_backslash_str start #1 }
  }
\cs_new:Npn \@@_env_end_str:n #1
  {
    \@@_format_case:nnn
      { \c_backslash_str end \c_left_brace_str #1 \c_right_brace_str }
      { \c_backslash_str end #1 }
      { \c_backslash_str stop #1 }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{junk-after-begin, env-already-defined}
%   The \enquote{error} |junk-after-begin| is raised when there are
%   characters after the start of the environment or its
%   \emph{optional argument} on the same line and the \enquote{error}
%   |env-already-defined| is
%   raised when |\newenvsc| is used with the name of an environment that
%   already exists.
%    \begin{macrocode}
\msg_new:nnnn { scontents } { junk-after-begin }
  {
    Junk~characters~#1~\msg_line_context: :
    \\ \\
    #2
  }
  {
    Nothing~is~allowed~after~the~start~of~the~environment~on~the~same~
    line.~These~characters~are~ignored.
  }
\msg_new:nnnn { scontents } { env-already-defined }
  { Environment~'#1'~already~defined! }
  {
    You~have~used~\token_to_str:N \newenvsc \c_space_tl
    with~an~environment~that~already~has~a~definition. \\ \\
    The~existing~definition~of~'#1'~will~not~be~altered.
  }
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{Definition of messages for \cs[no-index]{newenvsc}}
%
% \begin{macro}[int]{empty-environment, rescanning-text, multiple-begin}
%   The \enquote{warning} |empty-environment| is issued when the
%   environment is empty, the \enquote{warning} |rescanning-text| when
%   there are characters after the end of the environment on the same line
%   and the \enquote{warning} |multiple-begin| when the environment starts
%   more than once on the same line. The start and the end of the
%   environment are written with \myhlc|\@@_env_begin_str:n| and
%   \myhlc|\@@_env_end_str:n|.
%    \begin{macrocode}
\msg_new:nnn { scontents } { empty-environment }
  { Environment~'#1'~is~empty~\msg_line_context:. }
\msg_new:nnn { scontents } { rescanning-text }
  {
    Rescanning~text~'#1'~after~\@@_env_end_str:n {#2}~
    \msg_line_context:.
  }
\msg_new:nnn { scontents } { multiple-begin }
  {
    Multiple~\@@_env_begin_str:n { \l_@@_env_name_tl }~
    \msg_line_context:.
  }
