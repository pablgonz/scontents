% \subsubsection{Definition of error messages}
%
% \begin{macro}[int]{undefined-storage, index-out-of-range}
%   The \enquote{error} |undefined-storage| is raised when the
%   \emph{sequence} passed to |\getstored|, |\foreachsc|, |\typestored|,
%   |\meaningsc|, |\mergesc| or |\countsc| does not exist
%   (\S\ref{fun:sequences},~\S\ref{cmd:foreachsc},~\S\ref{cmd:mergesc},
%   ~\S\ref{cmd:countsc})
%   and the \enquote{error} |index-out-of-range| is raised when the
%   \mymeta{index} is zero or its absolute value is greater than the
%   number of \mymeta{stored contents}
%   (\S\ref{fun:sequences},~\S\ref{cmd:mergesc}).
%    \begin{macrocode}
\msg_new:nnnn { scontents } { undefined-storage }
  { Storage~named~'#1'~is~not~defined. }
  { No~content~has~been~stored~in~a~sequence~named~'#1'. }
\msg_new:nnnn { scontents } { index-out-of-range }
  {
    \int_compare:nNnTF {#1} = { 0 }
      { Index~of~sequence~'#2'~cannot~be~zero. }
      {
        Index~'#1'~out~of~range~for~'#2',~the~
        \int_compare:nNnTF {#1} > { 0 }
          { maximum~is~#3. }
          { minimum~is~-#3. }
      }
  }
  {
    The~sequence~'#2'~has~#3~stored~contents,~use~an~index~from~
    1~to~#3~or~from~-#3~to~-1.
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{positive-integer, empty-store-name}
%   The \enquote{error} |positive-integer| is raised when the keys
%   \mykey{width-tab}, \mykey{start}, \mykey{step} or \mykey{stop} receive
%   a value that is not a \mymeta{positive integer}
%   (\S\ref{key:package},~\S\ref{key:foreachsc}) and the \enquote{error}
%   |empty-store-name| is raised when the name of the \emph{sequence} is
%   blank (\S\ref{fun:sequences}).
%    \begin{macrocode}
\msg_new:nnnn { scontents } { positive-integer }
  { The~key~'#1'~needs~a~positive~integer,~'#2'~given~\msg_line_context:. }
  { The~value~'#2'~is~ignored~and~the~key~'#1'~keeps~its~previous~value. }
\msg_new:nnnn { scontents } { empty-store-name }
  { Empty~sequence~name~for~storing~content~\msg_line_context:. }
  {
    The~keys~'store-env',~'store-cmd'~and~'store-all'~need~a~non-empty~
    sequence~name.~The~content~will~not~be~stored.
  }
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{Definition of messages for writing files}
%
% \begin{macro}[int]{writing-file, overwrite-file, not-writing}
%   The \enquote{info} messages |writing-file| and |overwrite-file| are
%   written to the \texttt{.log} file when an \mymeta{output file} is
%   written or overwritten and the \enquote{warning} |not-writing| is
%   issued when the \mymeta{output file} already exists and the key
%   \mykey{overwrite} is not active (\S\ref{fun:utility}).
%    \begin{macrocode}
\msg_new:nnn { scontents } { writing-file }
  { Writing~file~'#1'. }
\msg_new:nnn { scontents } { overwrite-file }
  { Overwriting~file~'#1'. }
\msg_new:nnn { scontents } { not-writing }
  { File~'#1'~already~exists.~Not~writing~\msg_line_context:. }
%</core>
%    \end{macrocode}
% \end{macro}
