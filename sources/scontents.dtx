\NewDocumentCommand \newenvsc { m O{} }
  {
%<latex|plain>    \cs_if_exist:cTF {#1}
%<context>    \cs_if_exist:cTF { start #1 }
      { \msg_error:nnn { scontents } { env-already-defined } {#1} }
