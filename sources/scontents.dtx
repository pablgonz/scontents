% \subsection{The command \cs{mergesc}}\label{cmd:mergesc}
%
% The user-level command |\mergesc| takes an optional argument with the
% \mymeta{keys} and a mandatory argument with a \emph{comma separated
% list} of \mymarg{seq name} followed by an optional \mymeta{index} or
% range. It assembles the \mymeta{stored contents} in a temporary
% \emph{internal sequence} and passes it to |\typestored| or |\meaningsc|.
%
% \subsubsection{Definition of variables for \cs[no-index]{mergesc}}
%
% \begin{macro}[int]{\l_@@_mergesc_arg_tl, \l_@@_mergesc_keys_tl}
%   The token list \myhlc|\l_@@_mergesc_arg_tl| saves the last
%   \mymeta{stored content} assembled and the token list
%   \myhlc|\l_@@_mergesc_keys_tl| saves the \mymeta{keys} passed to
%   |\typestored| or |\meaningsc|.
%    \begin{macrocode}
\tl_new:N \l_@@_mergesc_arg_tl
\tl_new:N \l_@@_mergesc_keys_tl
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{Definition of error messages for \cs[no-index]{mergesc}}
%
% \begin{macro}[int]{mergesc-missing-key}
%   The \enquote{error} |mergesc-missing-key| is raised when neither the
%   \mykey{typestored} key nor the \mykey{meaningsc} key is passed to
%   |\mergesc|.
%    \begin{macrocode}
\msg_new:nnnn { scontents } { mergesc-missing-key }
  {
    Missing~mandatory~key~'typestored'~or~'meaningsc'~for~
    \c_backslash_str mergesc~\msg_line_context:.
  }
  {
    The~command~\c_backslash_str mergesc~needs~one~of~the~keys~
    'typestored'~or~'meaningsc'.\\
    Check~that~you~have~spelled~the~key~name~correctly.
  }
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{Definition of keys for \cs[no-index]{mergesc}}
%
% \begin{macro}[int]{typestored, meaningsc, \@@_mergesc_cmd:nn}
%   The \mymeta{keys} \mykey{typestored} and \mykey{meaningsc} are
%   \emph{mandatory}, they set the function
%   \myhlc|\@@_mergesc_cmd:nn|, which by default raises the
%   \enquote{error} |mergesc-missing-key|.
%    \begin{macrocode}
\keys_define:nn { scontents / mergesc }
  {
    typestored .code:n            =
      {
        \cs_set_eq:NN \@@_mergesc_cmd:nn \@@_typestored:nn
      },
    typestored .value_forbidden:n = true,
    meaningsc  .code:n            =
      {
        \cs_set_eq:NN \@@_mergesc_cmd:nn \@@_meaningsc:nn
      },
    meaningsc  .value_forbidden:n = true,
  }
\cs_new_protected:Npn \@@_mergesc_cmd:nn #1 #2
  {
    \msg_error:nn { scontents } { mergesc-missing-key }
  }
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{Internal functions for \cs[no-index]{mergesc}}
%
% \begin{macro}[int]{\@@_mergesc_code:nn}
%   The function \myhlc|\@@_mergesc_code:nn| sets the known \mymeta{keys}
%   passed in |#1|, saves the others in \myhlc|\l_@@_mergesc_keys_tl|,
%   assembles the \emph{internal sequence} from the list passed in |#2|
%   and, if it is not empty, passes it to \myhlc|\@@_mergesc_cmd:nn|.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_mergesc_code:nn #1 #2
  {
    \group_begin:
      \tl_clear:N \l_@@_mergesc_keys_tl
      \tl_if_novalue:nF {#1}
        {
          \keys_set_known:nnN { scontents / mergesc } {#1}
            \l_@@_mergesc_keys_tl
        }
      \seq_gclear:c { g_@@_name_sc!internal_seq }
      \@@_mergesc_parse_list:n {#2}
      \seq_if_empty:cF { g_@@_name_sc!internal_seq }
        {
          \exp_args:Ne \@@_mergesc_cmd:nn
            { 1-end, \exp_not:V \l_@@_mergesc_keys_tl } { sc!internal }
        }
    \group_end:
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]
%   {
%     \@@_mergesc_parse_list:n,
%     \@@_mergesc_parse_item:n,
%     \@@_parse_mergesc:nw,
%     \@@_parse_mergesc_aux:nw,
%     \@@_mergesc_put_item:nn,
%   }
%   The function \myhlc|\@@_mergesc_parse_list:n| parses each item of the
%   list with \myhlc|\@@_mergesc_parse_item:n|, which passes the
%   \mymarg{seq name} between braces to \myhlc|\@@_parse_mergesc:nw| when
%   the item has no \mymeta{index}, because the \emph{comma separated
%   list} removes the braces around an item. The function
%   \myhlc|\@@_parse_mergesc:nw| raises the \enquote{error}
%   |undefined-storage| if the \emph{sequence} does not exist and uses all
%   the \mymeta{stored contents} of the \emph{sequence} if there is no
%   \mymeta{index}. The function \myhlc|\@@_parse_mergesc_aux:nw| uses
%   \myhlc|\@@_range_parser:nnn| (\S\ref{fun:range-parser}) and
%   \myhlc|\@@_mergesc_put_item:nn| adds each \mymeta{stored content} to
%   the \emph{internal sequence} or raises the \enquote{error}
%   |index-out-of-range|, except for the \mymeta{stored contents} that
%   are not available yet in a remembered \emph{sequence}
%   (\S\ref{subsec:remember}). Finally the end of line of the last
%   \mymeta{stored content} is removed with
%   \myhlc|\@@_remove_trailing_eol:N|.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_mergesc_parse_list:n #1
  {
    \clist_map_inline:nn {#1} { \@@_mergesc_parse_item:n {##1} }
    \seq_if_empty:cF { g_@@_name_sc!internal_seq }
      {
        \seq_gpop_right:cN { g_@@_name_sc!internal_seq } \l_@@_mergesc_arg_tl
        \@@_remove_trailing_eol:N \l_@@_mergesc_arg_tl
        \seq_gput_right:cV { g_@@_name_sc!internal_seq } \l_@@_mergesc_arg_tl
      }
  }
\cs_new_protected:Npn \@@_mergesc_parse_item:n #1
  {
    \tl_if_in:nnTF {#1} { [ } % ]
      { \@@_parse_mergesc:nw #1 \s_@@_stop }
      { \@@_parse_mergesc:nw {#1} \s_@@_stop }
  }
\cs_new_protected:Npn \@@_parse_mergesc:nw #1
  {
    \@@_seq_if_exist:nTF {#1}
      {
        \peek_remove_spaces:n
          {
            \peek_charcode:NTF [ % ]
              { \@@_parse_mergesc_aux:nw {#1} }
              { \@@_parse_mergesc_aux:nw {#1} [ 1-end ] }
          }
      }
      {
        \msg_error:nnn { scontents } { undefined-storage } {#1}
        \@@_use_none_delimit_by_s_stop:w
      }
  }
\cs_new_protected:Npn \@@_parse_mergesc_aux:nw #1 [#2]
  {
    \seq_clear:N \l_@@_seq_item_seq
    \clist_map_inline:nn {#2}
      {
        \@@_range_parser:nnn {##1} { \@@_seq_count:n {#1} }
          { \msg_error:nnn { scontents } { cmd-key-unknown } }
      }
    \seq_map_inline:Nn \l_@@_seq_item_seq
      { \@@_mergesc_put_item:nn {#1} {##1} }
    \@@_use_none_delimit_by_s_stop:w
  }
\cs_new_protected:Npn \@@_mergesc_put_item:nn #1 #2
  {
    \@@_if_pending:nnF {#1} {#2}
      {
        \bool_lazy_or:nnTF
          { \int_compare_p:nNn {#2} = { 0 } }
          {
            \int_compare_p:nNn { \int_abs:n {#2} }
              > { \@@_seq_count:n {#1} }
          }
          {
            \msg_error:nneee { scontents } { index-out-of-range }
              {#2} {#1} { \@@_seq_count:n {#1} }
          }
          {
            \seq_gput_right:ce { g_@@_name_sc!internal_seq }
              { \@@_seq_item:nn {#1} {#2} }
          }
      }
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mergesc}
%   Defines the user command \ics*{mergesc}.
%    \begin{macrocode}
\NewDocumentCommand \mergesc { o m }
  {
    \tl_set:Nn \l_@@_cmd_name_tl { mergesc }
    \@@_mergesc_code:nn {#1} {#2}
  }
%    \end{macrocode}
% \end{macro}
