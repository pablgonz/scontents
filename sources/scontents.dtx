% not support LuaMetaTeX.
% \end{important}
%
% \subsection{The TAB character}\label{subsec:tabcharacter}
%
% Some users use the horizontal \texttt{TAB} `\LKeyTab' character from
% keyboard to indent the source code of the document and depending on the text editor
% used, some will use real \texttt{TAB} (\emph{hard tabs}), others with
% \emph{soft tabs} (\verb*+  + or \verb*+    +) or both.
%
% At first glance it may seem the same, but the way in which \texttt{TAB} character
% (\emph{hard tabs}) are processed according to the context in which they are found within
% a file, both in \mymeta{reading}\footnote{Check the answer given by Ulrich Diez
% in \href{https://tex.stackexchange.com/a/508103/7832}{Keyboard TAB
% character in argument v (xparse)}.} and \mymeta{writing}\footnote{Check the answer
% given by Enrico Gregorio in \href{https://tex.stackexchange.com/a/58740/7832}{How to output a
% tabulation into a file}.} are different and may have adverse consequences.
%
% In a standard \hologo{LaTeX} document, the character \texttt{TAB} `\LKeyTab'
% are treated as explicit spaces (in most contexts) and is the behavior when
% \mymeta{stored content}, but when \mymeta{writing files} these are preserved.
%
% With a \hologo{TeX} Live distribution, the \texttt{TAB} character is \emph{printable}
% for |latex|, |pdflatex| and |lualatex|, but if you use |xelatex| you
% must add the |-8bit| option on the command
% line, otherwise you will get \hologo{TeX} character \texttt{TAB} `|^^I|'
% in the \mymeta{output file}.
%
% As a general recommendation \emph{\enquote{Do not use \texttt{TAB} character unless strictly
% necessary}}, for example within a \emph{\enquote{verbatim environment}} that supports
% this character such as \myenv{Verbatim} of the packages \mypkg{fancyvrb}\cite{fancyvrb},
% \mypkg{fvextra}\cite{fvextra} or \myenv{lstlisting} of the package \mypkg{listings}\cite{listings}
% or when you want to generate a |MakeFile| file.
%
% \subsection{Configuration of the options}\label{subsec:confopt}
%
% Most of the options can be passed directly to the package or using the
% command |\setupsc|. All boolean keys can be passed using the
% equal sign `\textnormal{\textcolor{gray}{=}}' or just the
% name of the key, all unknown \mymeta{keys} will return an error. In this section
% are described some of the options, a summary of all options is shown in \S\ref{subsec:optover}.
%
% \begin{function}{\setupsc}
%   \begin{syntax}
%     \cmdexamp{setupsc}{key \textnormal{\textcolor{gray}{=}} val}
%   \end{syntax}
%
% The command \ics*{setupsc} takes the mandatory argument
% \mymarg{key \textnormal{\textcolor{gray}{=}} val} and sets the \mymeta{keys} for the rest of the
% document, or until the end of the current group, it can be used both in
% the preamble and in the body of the document as many times as desired.
% However, options set in the declaration of an environment (with
% |\newenvsc|) have precedence over options set with |\setupsc|.
%
% Options in the optional arguments of environments and
% commands have the highest precedence, overriding both
% options in |\newenvsc| and in |\setupsc|.
% \end{function}
%
% \keyexampcmd{debug-var}{true \textnormal{\textcolor{lightgray}{\textbar}} false}{true}[setupsc]
% Determines whether the \mymeta{argument} passed to commands or the \mymeta{body} passed
% to provided environments is written to the \texttt{.log} file. This \mymeta{key}
% is only available as a package option or using |\setupsc|.
%
% \keyexampcmd{verb-font}{font family}{\textnormal{\ttfamily\textbackslash{}ttfamily}}[setupsc]
% Sets the \mymeta{font family} used to display the \mymeta{stored content} for
% |\typestored|, |\mergesc| and |\meaningsc| commands. This \mymeta{key}
% is only available as a package option or using |\setupsc|.
%
% \keyexampcmd{store-all}{seq name}{not used}[setupsc]
% It is a \mymeta{meta-key} that sets the \mykey{store-env} key of the \myenv*[no-index]{scontents}
% environment and the \mykey{store-cmd} key of the |\Scontents| command. This \mymeta{key}
% is only available as a package option or using |\setupsc|.
%
% \keyexampcmd{remember}{seq names}{not used}[setupsc]
% Sets the \emph{sequences}, a comma separated list of \mymarg{seq names},
% whose \mymeta{stored contents} can be used before they are stored, as
% |\label| and |\ref| do with the references. At the end of the document
% the \mymeta{stored contents} of these \emph{sequences} are written to the
% file |\jobname.sct| and in the next compilation |\getstored|,
% |\foreachsc|, |\typestored|, |\meaningsc|, |\mergesc| and |\countsc|
% take the \mymeta{stored contents} from it, so they are available before
% they are stored.
% As with the references, two compilations are needed: the first one prints
% nothing where a \mymeta{stored content} is not available yet and a
% \enquote{warning} at the end of the document asks to compile again. If
% a \mymeta{stored content} is still not available, for example with an
% \mymeta{index} greater than the number of \mymeta{stored contents}, a
% \enquote{warning} says that there were undefined \mymeta{stored contents}.
% This \mymeta{key} is only available in \hologo{LaTeX}, in the preamble,
% as a package option or using |\setupsc|. For example:
% \iffalse
%<*example>
% \fi
\begin{examplecode}[frame=single]
\setupsc{remember=objectives} % in the preamble
\section{Objectives}
\getstored[1]{objectives}
\section{Methods}
\Scontents[store-cmd=objectives]{Measure the effect of the method.}
\end{examplecode}
% \iffalse
%</example>
% \fi
% A complete example is in \S\ref{exa:remember}. The file |\jobname.sct| is
% an auxiliary file, as the |.aux| file, and it can be removed at any time.
% To remove it with |latexmk -c| add this line to the \myfile{latexmkrc}
% file:
% \iffalse
%<*example>
% \fi
\begin{examplecode}[frame=single]
push @generated_exts, 'sct';
\end{examplecode}
% \iffalse
%</example>
% \fi
%
% \keyexampcmd{overwrite}{true \textnormal{\textcolor{lightgray}{\textbar}} false}{false}[setupsc]
% Sets whether the \mymeta{files} generated by \mykey{write-out} and \mykey{write-env}
% from the \myenv*[no-index]{scontents} environment will be rewritten. This \mymeta{key} is available as
% a package option, for |\setupsc|, for |\Scontents| and
% |\Scontents*|, for the base environment \myenv*[no-index]{scontents} and all
% environments created using |\newenvsc|.
%
% \keyexampcmd{print-all}{true \textnormal{\textcolor{lightgray}{\textbar}} false}{false}[setupsc]
% It is a \mymeta{meta-key} that sets the \mykey{print-env} key of the \myenv*[no-index]{scontents}
% environment and the \mykey{print-cmd} key of the |\Scontents| command. This \mymeta{key} is
% only available as a package option or using |\setupsc|.
%
% \keyexampcmd{force-eol}{true \textnormal{\textcolor{lightgray}{\textbar}} false}{false}[setupsc]
% Sets if the \emph{last end of line} for the \mymeta{stored content} is hidden or not.
% This \mymeta{key} is necessary only if the \emph{last line} is the closing of some
% environment defined by \mypkg{fancyvrb}\cite{fancyvrb} or \mypkg{fvextra}\cite{fvextra}
% packages as |\end{Verbatim}| or another environment that does not support
% a comments `\texttt{\textcolor{gray}{\%}}' after closing |\end{<env>}%|.
% This \mymeta{key} is available for the base environment \myenv*[no-index]{scontents},
% the |\Scontents| and |\Scontents*| commands and all environments
% created using |\newenvsc|.
%
% \keyexampcmd{width-tab}{integer}{1}[setupsc]
% Sets the equivalence in \mymeta{spaces} for the character \texttt{TAB} `\LKeyTab'
% used when displaying \mymeta{stored content} in \emph{verbatim style}. The value
% must be a \mymeta{positive integer}. This \mymeta{key} is available for |\typestored|,
% |\mergesc| and |\meaningsc| commands.
%
% \subsection{Options Overview}\label{subsec:optover}
%
% \newcommand*{\xmark}{\textcolor{OrangeRed}{✘}}%
% \newcommand*{\cmark}{\textcolor{newlinkcolor}{✔}}%
%
% \setlength{\tabcolsep}{0.25em}
