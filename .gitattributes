# Text sources: always LF line endings
*.dtx  text eol=lf
*.ins  text eol=lf
*.lua  text eol=lf
*.sty  text eol=lf
*.tex  text eol=lf
*.lvt  text eol=lf
*.tlg  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.ann  text eol=lf

# PDFs generated by l3build and versioned in the repository: binary files,
# no text diff and no merge; marked as generated so that GitHub collapses
# them in the diffs of the pull requests
*.pdf  binary linguist-generated
